{
  "schemaVersion": 1,
  "displayName": "Copper Runtime",
  "buildName": "Copper",
  "applicationId": "com.copper.chat",
  "runtimePrefix": "/data/data/com.copper.chat/files/usr",
  "runtimeHome": "/data/data/com.copper.chat/files/home",
  "architecture": "aarch64",
  "androidCompatibility": "android7-plus",
  "packageVariant": "apt-android-7",
  "packageManager": "apt",
  "persistentRuntimeQuotaBytes": 2147483648,
  "repository": {
    "channel": "stable",
    "component": "main",
    "architecture": "aarch64",
    "baseUrl": null,
    "signing": {
      "required": true,
      "keyFingerprint": null,
      "note": "A release cannot be published until a Copper-controlled HTTPS endpoint and offline-generated archive signing key/fingerprint are configured. Never commit the private signing key."
    }
  },
  "bootstrap": {
    "additionalPackages": [],
    "requiredFiles": [
      "bin/bash",
      "bin/apt",
      "bin/pkg",
      "bin/termux-setup-storage",
      "bin/termux-exec-ld-preload-lib",
      "lib/libtermux-exec.so",
      "SYMLINKS.txt"
    ],
    "startupTextMembers": [
      {
        "archivePath": "etc/profile.d/init-termux-properties.sh",
        "requiredFragments": [
          "/data/data/com.copper.chat/files/home/.termux",
          "/data/data/com.copper.chat/files/usr/share/examples/termux/termux.properties"
        ]
      },
      {
        "archivePath": "etc/termux/termux-bootstrap/second-stage/termux-bootstrap-second-stage.sh",
        "requiredFragments": [
          "#!/data/data/com.copper.chat/files/usr/bin/bash",
          "export TERMUX_PREFIX=\"/data/data/com.copper.chat/files/usr\"",
          "export TERMUX_PACKAGE_MANAGER=\"apt\"",
          "export TERMUX_PACKAGE_ARCH=\"aarch64\""
        ]
      },
      {
        "archivePath": "etc/profile.d/01-termux-bootstrap-second-stage-fallback.sh",
        "requiredFragments": [
          "/data/data/com.copper.chat/files/usr/etc/termux/termux-bootstrap/second-stage/termux-bootstrap-second-stage.sh"
        ]
      }
    ]
  },
  "temporaryBuildMirror": {
    "enabled": false,
    "retention": "delete-after-completed-failed-or-cancelled-build",
    "excludedNames": [".git", "node_modules", ".gradle", "build", "dist"]
  }
}
